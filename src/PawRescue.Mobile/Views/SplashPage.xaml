<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PawRescue.Mobile.Views"
                xmlns:vm="clr-namespace:PawRescue.Mobile.ViewModels"
                x:Class="PawRescue.Mobile.Views.SplashPage"
                x:DataType="vm:SplashViewModel"
                BackgroundColor="{StaticResource Primary}">

    <Grid RowDefinitions="*,Auto,Auto,*,Auto" Padding="24">
        <Border x:Name="LogoCircle" Grid.Row="1" WidthRequest="132" HeightRequest="132"
                StrokeShape="RoundRectangle 66" StrokeThickness="0" BackgroundColor="White"
                HorizontalOptions="Center">
            <Image Source="paw_logo.png" WidthRequest="96" HeightRequest="96" />
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="6" Margin="0,24,0,0">
            <Label Text="Paw Rescue" FontSize="34" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
            <Label Text="Every paw deserves a second chance" FontSize="15" TextColor="#FCE8EA" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="4" IsRunning="True" Color="White" Margin="0,0,0,32" />
    </Grid>
</views:BasePage>
