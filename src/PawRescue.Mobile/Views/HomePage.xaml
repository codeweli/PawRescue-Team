<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PawRescue.Mobile.Views"
                xmlns:vm="clr-namespace:PawRescue.Mobile.ViewModels"
                x:Class="PawRescue.Mobile.Views.HomePage"
                x:DataType="vm:HomeViewModel"
                Shell.NavBarIsVisible="False">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding NearbyReports}"
                        ItemTemplate="{StaticResource ReportCardTemplate}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedReport}">

            <CollectionView.Header>
                <VerticalStackLayout Padding="16,16,16,4" Spacing="16">

                    <!-- Header: logo + greeting + bell -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                            <Image Source="paw_white.png" WidthRequest="26" HeightRequest="26" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Text="{Binding Greeting}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="Paw Rescue" Style="{StaticResource Headline}" FontSize="26" />
                        </VerticalStackLayout>
                        <Grid Grid.Column="2" WidthRequest="46" HeightRequest="46" VerticalOptions="Center">
                            <Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" StrokeShape="RoundRectangle 23">
                                <Image Source="icon_bell.png" WidthRequest="22" HeightRequest="22" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                            <BoxView Color="{StaticResource Primary}" WidthRequest="9" HeightRequest="9" CornerRadius="4.5"
                                     HorizontalOptions="End" VerticalOptions="Start" Margin="0,10,11,0"
                                     IsVisible="{Binding HasUnread}" />
                        </Grid>
                    </Grid>

                    <!-- Search -->
                    <Border Style="{StaticResource SearchField}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_search.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Search reports, places, animals"
                                   ReturnType="Search" ReturnCommand="{Binding SearchCommand}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Quick actions -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource ActionTile}" BackgroundColor="{StaticResource Primary}">
                            <Grid RowDefinitions="*,Auto">
                                <Image Source="icon_plus_white.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Start" />
                                <Label Grid.Row="1" Text="Report&#10;Animal" TextColor="White" FontFamily="NunitoBold" FontSize="14" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReportAnimalCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ActionTile}">
                            <Grid RowDefinitions="*,Auto">
                                <Image Source="icon_map_red.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Start" />
                                <Label Grid.Row="1" Text="View Map" TextColor="{StaticResource PrimaryDark}" FontFamily="NunitoBold" FontSize="14" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenMapCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ActionTile}">
                            <Grid RowDefinitions="*,Auto">
                                <Image Source="icon_list_red.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Start" />
                                <Label Grid.Row="1" Text="Rescue Cases" TextColor="{StaticResource PrimaryDark}" FontFamily="NunitoBold" FontSize="14" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCasesCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <!-- Community stats -->
                    <Border Style="{StaticResource Card}" Padding="8,16">
                        <Grid ColumnDefinitions="*,1,*,1,*">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding AnimalsReported}" Style="{StaticResource StatNumber}" />
                                <Label Text="Animals Reported" Style="{StaticResource StatLabel}" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="1" Color="{StaticResource Border}" WidthRequest="1" />
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="{Binding AnimalsHelped}" Style="{StaticResource StatNumber}" />
                                <Label Text="Animals Helped" Style="{StaticResource StatLabel}" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="3" Color="{StaticResource Border}" WidthRequest="1" />
                            <VerticalStackLayout Grid.Column="4" Spacing="2">
                                <Label Text="{Binding ActiveCases}" Style="{StaticResource StatNumber}" />
                                <Label Text="Active Cases" Style="{StaticResource StatLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Role shortcuts -->
                    <Button Text="Volunteer Dashboard" Style="{StaticResource SecondaryButton}"
                            IsVisible="{Binding IsVolunteer}" Command="{Binding OpenVolunteerDashboardCommand}" />
                    <Button Text="Admin Dashboard" Style="{StaticResource OutlineButton}"
                            IsVisible="{Binding IsAdmin}" Command="{Binding OpenAdminDashboardCommand}" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <Label Text="{Binding NearbyTitle}" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="See all" Style="{StaticResource LinkLabel}" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCasesCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" Spacing="8" HorizontalOptions="Center">
                    <Label Text="🐾" FontSize="44" HorizontalOptions="Center" />
                    <Label Text="No animals reported nearby" Style="{StaticResource SectionTitle}" HorizontalOptions="Center" />
                    <Label Text="That's good news! Pull down to refresh." Style="{StaticResource Caption}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</views:BasePage>
