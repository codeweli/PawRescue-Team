<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PawRescue.Mobile.Views"
                xmlns:vm="clr-namespace:PawRescue.Mobile.ViewModels"
                x:Class="PawRescue.Mobile.Views.ProfilePage"
                x:DataType="vm:ProfileViewModel"
                Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,24" Spacing="14">
            <Label Text="{Binding Title}" Style="{StaticResource ScreenTitle}" />

            <!-- Pink header card -->
            <Border BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16,18">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32" StrokeThickness="0"
                            BackgroundColor="{StaticResource Primary}">
                        <Label Text="{Binding Initials}" FontFamily="{StaticResource SerifFont}" FontSize="24" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding Profile.User.FullName}" Style="{StaticResource Title}" FontSize="21" />
                        <Label Text="{Binding RoleText}" Style="{StaticResource Caption}" FontSize="14" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Stats -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Style="{StaticResource StatCard}" Padding="8,14">
                    <VerticalStackLayout>
                        <Label Text="{Binding Profile.Stats.ReportsSubmitted}" Style="{StaticResource StatNumber}" FontSize="22" />
                        <Label Text="Reports" Style="{StaticResource StatLabel}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatCard}" Padding="8,14">
                    <VerticalStackLayout>
                        <Label Text="{Binding Profile.Stats.RescuesCompleted}" Style="{StaticResource StatNumber}" FontSize="22" />
                        <Label Text="Assists" Style="{StaticResource StatLabel}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatCard}" Padding="8,14">
                    <VerticalStackLayout>
                        <Label Text="{Binding Profile.Stats.ReportsRescued}" Style="{StaticResource StatNumber}" FontSize="22" />
                        <Label Text="Rescued" Style="{StaticResource StatLabel}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Edit profile (shown after tapping "Edit profile") -->
            <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding IsEditing}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Edit profile" Style="{StaticResource SectionTitle}" Margin="0" />
                    <Label Text="Full name" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding EditFullName}" />
                    </Border>
                    <Label Text="Mobile number" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding EditPhone}" Keyboard="Telephone" />
                    </Border>
                    <Label Text="{Binding Profile.User.Email, StringFormat='Email: {0}'}" Style="{StaticResource Caption}" Margin="2,4,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Text="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelEditCommand}" />
                        <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Menu -->
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto" Padding="16,16" BackgroundColor="White">
                            <Label Text="My reports" FontFamily="NunitoBold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="1" Source="icon_chevron.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenMyReportsCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" Margin="16,0" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,16" BackgroundColor="White">
                            <Label Text="Edit profile" FontFamily="NunitoBold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="1" Source="icon_chevron.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding StartEditCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" Margin="16,0" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,16" BackgroundColor="White">
                            <Label Text="Notification settings" FontFamily="NunitoBold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="1" Source="icon_chevron.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenNotificationSettingsCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" Margin="16,0" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,16" BackgroundColor="White">
                            <Label Text="Help and safety tips" FontFamily="NunitoBold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="1" Source="icon_chevron.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSafetyTipsCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" Margin="16,0"  IsVisible="{Binding IsVolunteer}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,16" BackgroundColor="White" IsVisible="{Binding IsVolunteer}">
                            <Label Text="Volunteer dashboard" FontFamily="NunitoBold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="1" Source="icon_chevron.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenVolunteerDashboardCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" Margin="16,0"  IsVisible="{Binding IsAdmin}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,16" BackgroundColor="White" IsVisible="{Binding IsAdmin}">
                            <Label Text="Admin dashboard" FontFamily="NunitoBold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="1" Source="icon_chevron.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAdminDashboardCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Log out" Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
