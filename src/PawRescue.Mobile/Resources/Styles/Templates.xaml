<?xml version="1.0" encoding="UTF-8" ?>
<!-- Reusable list-item templates (the "report card" appears on Home, Volunteer, Profile and Admin). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:m="clr-namespace:PawRescue.Mobile.Models">

    <!-- Report card (Home "Needs help nearby", Rescue Cases, Volunteer, Admin) -->
    <DataTemplate x:Key="ReportCardTemplate" x:DataType="m:ReportSummaryDto">
        <Grid Padding="16,6" Style="{StaticResource NoSelectionHighlight}">
            <Border Style="{StaticResource Card}" Padding="10">
                <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
                    <!-- Photo -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="96" WidthRequest="96"
                            BackgroundColor="{StaticResource SurfaceMuted}">
                        <Grid>
                            <Label Text="{Binding AnimalEmoji}" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3" VerticalOptions="Center">
                        <!-- Name + badge -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <Label Text="{Binding Title}" Style="{StaticResource CardName}" VerticalOptions="Center" />
                            <Border Grid.Column="1" Style="{StaticResource StatusPill}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsHighPriority}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding BadgeText}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsHighPriority}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>

                        <Label Grid.Row="1" Text="{Binding AnimalType}" Style="{StaticResource Caption}" Margin="0,0,0,6" />

                        <HorizontalStackLayout Grid.Row="2" Spacing="6">
                            <Image Source="icon_pin_dark.png" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                            <Label Text="{Binding LocationText}" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="3" Spacing="8">
                            <BoxView Color="{Binding NeedColor}" WidthRequest="9" HeightRequest="9" CornerRadius="4.5" VerticalOptions="Center" />
                            <Label Text="{Binding NeedText}" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Selected item shouldn't turn grey on Android -->
    <Style x:Key="NoSelectionHighlight" TargetType="Grid">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
</ResourceDictionary>
